.ipynb_checkpoints/

# Evaluation results — auto-saved locally, not tracked in git
results/*
!results/.gitkeep

# OS
.DS_Store
Thumbs.db

# PDFs
*.pdf

# Logs / output text files
*.txt
!Tokenizers-Outline.txt

# IDE
.vscode/
.idea/
